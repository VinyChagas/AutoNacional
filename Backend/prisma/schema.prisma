// Schema Prisma - AutoNacional Backend
// PostgreSQL próprio (VPS) via DATABASE_URL — fonte de verdade do schema físico.
// Não execute `prisma migrate` contra a VPS nesta fase; o banco já existe.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ============================================================================
// Contabilidades (para vínculo com empresas e certificados)
// ============================================================================
model Contabilidade {
  id                Int      @id @default(autoincrement())
  nomeContabilidade String   @map("nome_contabilidade")
  cnpj              String   @unique
  email             String?
  telefone          String?
  responsavel       String?
  dataCadastro      DateTime @default(now()) @map("data_cadastro")

  empresas           Empresa[]
  certificados       Certificado[]
  execucaoBatchLogs  ExecucaoBatchLog[]
  execucaoLogBatches ExecucaoLogBatch[]

  @@map("contabilidades")
}

// ============================================================================
// Empresas
// ============================================================================
model Empresa {
  id              Int      @id @default(autoincrement())
  cnpj            String   @unique
  razaoSocial     String   @map("razao_social")
  regime          String?
  ativo           Boolean  @default(true)
  contabilidadeId Int?     @map("contabilidade_id")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  contabilidade Contabilidade? @relation(fields: [contabilidadeId], references: [id], onDelete: SetNull)
  credenciais   Credencial[]
  execucoes     Execucao[]

  @@map("empresas")
}

// ============================================================================
// Credenciais (login CNPJ/CPF + senha)
// ============================================================================
model Credencial {
  id                 Int       @id @default(autoincrement())
  empresaId          Int       @map("empresa_id")
  tipo               String // CNPJ_SENHA ou CPF_SENHA
  usuario            String // CNPJ ou CPF (sem formatação)
  senhaCriptografada String    @map("senha_criptografada")
  status             String    @default("NAO_TESTADO") // NAO_TESTADO, OK, INVALIDA, ERRO_VALIDACAO, BLOQUEADA
  ultimoTesteEm      DateTime? @map("ultimo_teste_em")
  ultimaMensagem     String?   @map("ultima_mensagem") // Ex: "Senha incorreta", "Falha ao validar"
  createdAt          DateTime  @default(now()) @map("created_at")
  updatedAt          DateTime  @updatedAt @map("updated_at")

  empresa Empresa @relation(fields: [empresaId], references: [id], onDelete: Cascade)

  @@unique([empresaId, tipo])
  @@map("credenciais")
}

// ============================================================================
// Certificados Digitais (arquivo PFX no Storage + senha criptografada)
// ============================================================================
model Certificado {
  id                  Int      @id @default(autoincrement())
  cnpj                String
  arquivo             String?  // Path no Supabase Storage
  senhaCriptografada  String?  @map("senha_criptografada")
  dataValidade        String?  @map("data_validade") // ISO string ou DD/MM/YYYY
  empresaId           String?  @map("empresa_id")
  contabilidadeId     Int?     @map("contabilidade_id")
  dataCadastro        DateTime @default(now()) @map("data_cadastro")

  contabilidade Contabilidade? @relation(fields: [contabilidadeId], references: [id], onDelete: SetNull)

  @@map("certificados_digitais")
}

// ============================================================================
// Settings (AutomationSettings - única linha)
// ============================================================================
model Settings {
  id                        Int     @id @default(autoincrement())
  headless                  Boolean @default(false)
  companyTimeoutSeconds     Int     @default(300) @map("company_timeout_seconds")
  maxRetriesPerStep         Int     @default(3) @map("max_retries_per_step")
  minActionDelayMs          Int     @default(500) @map("min_action_delay_ms")
  maxConcurrentBrowsers     Int     @default(5) @map("max_concurrent_browsers")
  defaultConcurrentBrowsers Int     @default(3) @map("default_concurrent_browsers")
  browserLaunchDelayMs      Int     @default(1000) @map("browser_launch_delay_ms")
  viewportPreset            String  @default("FULLHD") @map("viewport_preset")
  viewportWidth             Int?    @map("viewport_width")
  viewportHeight            Int?    @map("viewport_height")
  downloadsBasePath         String  @default("./downloads") @map("downloads_base_path")
  downloadsPattern          String  @default("{cnpj}/{ano}/{mes}") @map("downloads_pattern")
  logsPath                  String  @default("./logs") @map("logs_path")
  tempPath                  String  @default("./temp") @map("temp_path")
  logLevel                  String  @default("INFO") @map("log_level")
  saveErrorScreenshots      Boolean @default(true) @map("save_error_screenshots")
  generatePdfReport         Boolean @default(true) @map("generate_pdf_report")
  logRetentionDays          Int     @default(30) @map("log_retention_days")
  maxErrorsInPanel          Int     @default(100) @map("max_errors_in_panel")

  @@map("settings")
}

// ============================================================================
// Log de Lote de Execução (persistência de logs por batch)
// ============================================================================
model ExecucaoBatchLog {
  id                Int      @id @default(autoincrement())
  batchId           String   @unique @map("batch_id")
  contabilidadeId   Int?     @map("contabilidade_id")
  competencia       String   @map("competencia")
  dataInicio        String   @map("data_inicio")
  dataFim           String   @map("data_fim")
  tipo              String   @default("ambas")
  headless          Boolean  @default(false)
  totalEmpresas     Int      @default(0) @map("total_empresas")
  totalSucesso      Int      @default(0) @map("total_sucesso")
  totalFalha        Int      @default(0) @map("total_falha")
  totalEmitidas     Int      @default(0) @map("total_emitidas")
  totalRecebidas    Int      @default(0) @map("total_recebidas")
  totaisPorResultado Json?   @map("totais_por_resultado")
  itens             Json     @default("[]")
  createdAt         DateTime @default(now()) @map("created_at")

  contabilidade Contabilidade? @relation(fields: [contabilidadeId], references: [id], onDelete: SetNull)

  @@map("execucao_batch_log")
}

// ============================================================================
// Execuções (histórico de automações)
// ============================================================================
model Execucao {
  id                Int       @id @default(autoincrement())
  empresaId         Int       @map("empresa_id")
  cnpj              String?
  status            String    @default("pendente")
  etapaAtual        String    @default("inicio") @map("etapa_atual")
  progresso         Int       @default(0)
  periodoInicio     String?   @map("periodo_inicio")
  periodoFim        String?   @map("periodo_fim")
  tipo              String    @default("ambas")
  mensagem          String?   @default("Aguardando execução...")
  dataInicio        DateTime? @map("data_inicio")
  dataFim           DateTime? @map("data_fim")
  mensagemErro      String?   @map("mensagem_erro")
  qtdNotasEmitidas  Int       @default(0) @map("qtd_notas_emitidas")
  qtdNotasRecebidas Int       @default(0) @map("qtd_notas_recebidas")
  resultadoFinal    String?   @map("resultado_final")
  createdAt         DateTime  @default(now()) @map("created_at")
  atualizadoEm      DateTime  @updatedAt @map("atualizado_em")

  empresa Empresa @relation(fields: [empresaId], references: [id], onDelete: Cascade)

  @@map("execucoes")
}

// ============================================================================
// Logs de execução (header + itens) — Painel de Logs
// ============================================================================
model ExecucaoLogBatch {
  id                 Int       @id @default(autoincrement())
  batchId            String    @unique @map("batch_id") @db.VarChar(36)
  contabilidadeId    Int?      @map("contabilidade_id")
  competencia        String    @map("competencia") @db.VarChar(7)
  dataInicio         String?   @map("data_inicio") @db.VarChar(10)
  dataFim            String?   @map("data_fim") @db.VarChar(10)
  tipo               String    @default("ambas") @db.VarChar(20)
  headless           Boolean   @default(false)
  totalEmpresas      Int       @default(0) @map("total_empresas")
  totalSucesso       Int       @default(0) @map("total_sucesso")
  totalFalha         Int       @default(0) @map("total_falha")
  totalEmitidas      Int       @default(0) @map("total_emitidas")
  totalRecebidas     Int       @default(0) @map("total_recebidas")
  totaisPorResultado Json?     @map("totais_por_resultado")
  createdAt          DateTime? @default(now()) @map("created_at") @db.Timestamptz(6)

  contabilidade Contabilidade?    @relation(fields: [contabilidadeId], references: [id], onDelete: SetNull)
  itens         ExecucaoLogItem[]

  @@map("execucao_log_batch")
}

model ExecucaoLogItem {
  id               Int       @id @default(autoincrement())
  batchLogId       Int       @map("batch_log_id")
  empresaId        String    @map("empresa_id") @db.VarChar(50)
  cnpj             String    @db.VarChar(20)
  nomeEmpresa      String    @map("nome_empresa") @db.VarChar(255)
  tipoAutenticacao String?   @map("tipo_autenticacao") @db.VarChar(20)
  statusFinal      String    @map("status_final") @db.VarChar(20)
  qtdEmitidas      Int       @default(0) @map("qtd_emitidas")
  qtdRecebidas     Int       @default(0) @map("qtd_recebidas")
  resultadoFinal   String?   @map("resultado_final") @db.VarChar(50)
  startedAt        DateTime? @map("started_at") @db.Timestamptz(6)
  finishedAt       DateTime? @map("finished_at") @db.Timestamptz(6)
  erroMsg          String?   @map("erro_msg")

  batchLog ExecucaoLogBatch @relation(fields: [batchLogId], references: [id], onDelete: Cascade)

  @@map("execucao_log_item")
}

// ============================================================================
// Métricas de automação (Painel de Rentabilidade)
// UUID gerado pelo PostgreSQL via gen_random_uuid() quando omitido
// ============================================================================
model AutomationExecutionBatch {
  id              String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  competencia     String
  contabilidadeId Int?     @map("contabilidade_id")
  totalEmpresas   Int      @default(0) @map("total_empresas")
  status          String   @default("RUNNING")
  createdBy       String?  @map("created_by") @db.Uuid
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  executions AutomationExecution[]

  @@map("automation_execution_batches")
}

model AutomationExecution {
  id                    String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  batchId               String    @map("batch_id") @db.Uuid
  empresaId             Int       @map("empresa_id")
  empresaCnpj           String    @map("empresa_cnpj")
  contabilidadeId       Int?      @map("contabilidade_id")
  competencia           String
  status                String
  loginMetodo           String?   @map("login_metodo")
  qtdEmitidas           Int       @default(0) @map("qtd_emitidas")
  qtdRecebidas          Int       @default(0) @map("qtd_recebidas")
  qtdCanceladas         Int       @default(0) @map("qtd_canceladas")
  tempoExecucaoSegundos Int       @default(0) @map("tempo_execucao_segundos")
  erroResumo            String?   @map("erro_resumo")
  startedAt             DateTime? @map("started_at") @db.Timestamptz(6)
  finishedAt            DateTime? @map("finished_at") @db.Timestamptz(6)
  createdAt             DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  batch AutomationExecutionBatch @relation(fields: [batchId], references: [id], onDelete: Cascade)

  @@unique([batchId, empresaId], map: "automation_executions_batch_empresa_unique")
  @@map("automation_executions")
}
