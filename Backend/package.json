{
  "name": "autonacional-backend",
  "version": "1.0.0",
  "description": "Backend AutoNacional - API para automação NFSe (Node.js/Express/TypeScript)",
  "main": "dist/main.js",
  "scripts": {
    "dev": "cross-env NODE_OPTIONS=--openssl-legacy-provider ts-node-dev --respawn --transpile-only src/main.ts",
    "build": "tsc",
    "start": "cross-env NODE_OPTIONS=--openssl-legacy-provider node dist/main.js",
    "clean": "rimraf dist",
    "postinstall": "prisma generate",
    "prisma:generate": "prisma generate",
    "prisma:push": "prisma db push",
    "prisma:migrate": "prisma migrate dev",
    "prisma:studio": "prisma studio",
    "prisma:reset": "prisma migrate reset",
    "playwright:install": "playwright install chromium",
    "setup": "npm run prisma:generate && npm run prisma:push && npm run playwright:install",
    "test:playwright": "npx ts-node src/automation/scripts/test-playwright.ts",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "keywords": [
    "autonacional",
    "nfse",
    "automação",
    "playwright",
    "express",
    "prisma"
  ],
  "author": "Equipe AutoNacional",
  "license": "UNLICENSED",
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=9.0.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/cors": "^2.8.19",
    "@types/express": "^4.17.21",
    "@types/multer": "^2.0.0",
    "@types/node": "^25.2.3",
    "@types/node-forge": "^1.3.14",
    "cross-env": "^10.1.0",
    "prisma": "^6.19.3",
    "rimraf": "^6.1.3",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.9.3",
    "vitest": "^3.2.7"
  },
  "dependencies": {
    "@prisma/adapter-better-sqlite3": "^7.4.0",
    "@prisma/adapter-pg": "^7.4.0",
    "@prisma/client": "^7.4.0",
    "@supabase/supabase-js": "^2.95.3",
    "better-sqlite3": "^12.6.2",
    "chromedriver": "^150.0.0",
    "cors": "^2.8.6",
    "dotenv": "^17.3.1",
    "express": "^4.22.1",
    "multer": "^2.0.2",
    "node-forge": "^1.3.3",
    "p-queue": "^9.1.0",
    "pg": "^8.18.0",
    "pino": "^10.3.1",
    "playwright": "^1.58.2",
    "postgres": "^3.4.8",
    "socket.io": "^4.8.3",
    "xlsx": "^0.18.5",
    "zod": "^4.3.6"
  }
}
