# Supabase (server-side - NUNCA exponha ao frontend)
SUPABASE_URL=https://seu-projeto.supabase.co
SUPABASE_SERVICE_ROLE_KEY=<service_role_secret_do_projeto>
# Validação estrita: USE_SUPABASE=true exige SUPABASE_URL, SUPABASE_SERVICE_ROLE_KEY, CRYPTO_KEY, CERT_STORAGE_BUCKET
# USE_SUPABASE=true

# Bucket Supabase Storage para certificados .pfx
CERT_STORAGE_BUCKET=certificados

# Criptografia (credenciais, senhas)
CRYPTO_KEY=<chave-32-chars-ou-mais>

# Supabase Auth (JWT, opcional)
SUPABASE_JWKS_URL=https://seu-projeto.supabase.co/auth/v1/jwks
SUPABASE_AUDIENCE=authenticated
SUPABASE_ISSUER=https://seu-projeto.supabase.co/auth/v1

# Banco de dados (Supabase PostgreSQL)
DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.sabqvvgaracqouyzxdgb.supabase.co:5432/postgres

# SQLite (desenvolvimento local, alternativo):
# DATABASE_URL="file:./prisma/dev.db"

# Criptografia (CRYPTO_KEY prioridade; APP_CRED_KEY fallback)
CRYPTO_KEY=<chave-mestre-super-forte>
APP_CRED_KEY=<fallback-legado>
FERNET_KEY=<chave-fernet-32-bytes-base64>

# API Key (rotas internas)
INTERNAL_API_KEY=<api-key-forte>

# CORS (origens permitidas p/ Angular)
CORS_ORIGINS=http://localhost:4200,https://app.seu-dominio.com

# Playwright (automação NFSe)
# Timeout em ms; headless true/false
PLAYWRIGHT_TIMEOUT=30000
PLAYWRIGHT_HEADLESS=false
QUEUE_TIMEOUT=60

# Após npm install, execute: npx playwright install chromium
