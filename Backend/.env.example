# PostgreSQL próprio (VPS) — Prisma / dados relacionais
# Na rede Docker vinylab_internal (Backend no mesmo swarm/compose):
# DATABASE_URL=postgresql://autonacional_app:<SENHA>@vinylab-postgres:5432/autonacional?schema=public
#
# Desenvolvimento local: NÃO exponha 0.0.0.0:5432. Use SSH tunnel no Mac:
#   npm run tunnel:db
# (vinylab-postgres só resolve na rede Docker; o script usa o IP do container)
# DATABASE_URL=postgresql://autonacional_app:<SENHA>@127.0.0.1:5433/autonacional?schema=public
DATABASE_URL=postgresql://autonacional_app:[YOUR-PASSWORD]@vinylab-postgres:5432/autonacional?schema=public

# Storage de certificados PFX (NÃO expor via HTTP/Caddy)
# Driver: local (filesystem na mesma máquina) ou sftp (VPS remota)
CERT_STORAGE_DRIVER=local
CERT_STORAGE_PATH=/srv/data/autonacional/certificados

# SFTP (quando CERT_STORAGE_DRIVER=sftp — ex.: Backend no Mac, PFX na VPS)
# Autenticação: SSH_AUTH_SOCK (ssh-agent) OU CERT_STORAGE_SFTP_PRIVATE_KEY
# Chave com passphrase: use ssh-agent (`ssh-add`) — não grave passphrase no .env
# CERT_STORAGE_DRIVER=sftp
# CERT_STORAGE_SFTP_HOST=
# CERT_STORAGE_SFTP_PORT=22
# CERT_STORAGE_SFTP_USER=
# CERT_STORAGE_SFTP_PRIVATE_KEY=
# CERT_STORAGE_SFTP_BASE_PATH=/srv/data/autonacional/certificados

# Criptografia (credenciais, senhas)
CRYPTO_KEY=<chave-32-chars-ou-mais>

# Criptografia (CRYPTO_KEY prioridade; APP_CRED_KEY fallback)
CRYPTO_KEY=<chave-mestre-super-forte>
APP_CRED_KEY=<fallback-legado>
FERNET_KEY=<chave-fernet-32-bytes-base64>

# API Key (rotas internas)
INTERNAL_API_KEY=<api-key-forte>

# Porta da API (dev)
PORT=4321

# CORS (origens permitidas p/ Angular)
CORS_ORIGINS=http://localhost:4200,https://app.seu-dominio.com
# CORS_ORIGIN=http://localhost:4200

# Playwright (automação NFSe)
# Timeout em ms; headless true/false
PLAYWRIGHT_TIMEOUT=60000
PLAYWRIGHT_HEADLESS=false
QUEUE_TIMEOUT=60

# Após npm install, execute: npx playwright install chromium

# 2captcha — resolução automática de hCaptcha (rqdata opcional: omitir se não existir)
TWOCAPTCHA_API_KEY=
TWOCAPTCHA_API_VERSION=v2
CAPTCHA_SOLVE_TIMEOUT_MS=420000
CAPTCHA_IS_INVISIBLE=false
# Override opcional de rqdata. Deixe vazio para omitir quando não houver valor real.
# Nunca use c.req como substituto. Não envie "" ou null.
# TWOCAPTCHA_RQDATA=
CAPTCHA_MODE=auto_manual
CAPTCHA_MANUAL_TIMEOUT_MS=420000
# Proxy opcional (API v2 type=HCaptchaTask). Se vazio, usa HCaptchaTaskProxyless.
# TWOCAPTCHA_PROXY_TYPE=http
# TWOCAPTCHA_PROXY_ADDRESS=
# TWOCAPTCHA_PROXY_PORT=
# TWOCAPTCHA_PROXY_LOGIN=
# TWOCAPTCHA_PROXY_PASSWORD=

# Retry por operação de download (fecha modal, reclica XML/PDF, novo CAPTCHA)
CAPTCHA_OPERATION_MAX_ATTEMPTS=2
CAPTCHA_OPERATION_RETRY_DELAY_MS=4000
CAPTCHA_MODAL_CLOSE_TIMEOUT_MS=10000
CAPTCHA_NEW_CHALLENGE_TIMEOUT_MS=20000
CAPTCHA_NOTE_RELOCATION_TIMEOUT_MS=60000
CAPTCHA_OPERATION_FALLBACK_MANUAL=true
CAPTCHA_CONSECUTIVE_FAILURE_LIMIT=3
CAPTCHA_RETRYABLE_ERROR_CODES=ERROR_CAPTCHA_UNSOLVABLE
